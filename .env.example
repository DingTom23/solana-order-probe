# RPC endpoint used by the probe. A dedicated endpoint is recommended for the
# live run; the public endpoint is rate limited.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Path inside the container. The key is mounted read-only from ./wallet.
PAYER_KEYPAIR=wallet/solana.json

# Optional HTTP proxy for hosts that need one to reach the RPC.
RPC_PROXY=
